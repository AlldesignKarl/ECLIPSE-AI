# ─────────────────────────────────────────────────────────────
#  ECLIPSE AI · variables de entorno
#  Copia este archivo como .env.local para desarrollo, o pega
#  estas variables en el panel de tu hosting (Vercel, etc.).
# ─────────────────────────────────────────────────────────────

# ─── El motor de la IA ───────────────────────────────────────
# Hace falta UNA de las dos. Con Google la aplicación es gratis.

# GRATIS y sin tarjeta: https://aistudio.google.com/apikey
# Da chat, búsqueda en Google con fuentes, y creación de imágenes.
GOOGLE_API_KEY=

# De pago por uso: https://console.anthropic.com
# Alternativa si prefieres este motor. No tiene capa gratuita.
# ANTHROPIC_API_KEY=

# Con las dos configuradas se usa Google. Fuérzalo con: google | anthropic
# AI_PROVIDER=google

# Opcional. Si no se pone, la aplicación elige un modelo disponible sola.
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-opus-5

# ─── Plan Pro ────────────────────────────────────────────────
# Código que desbloquea vídeo, modo código y GitHub.
# Invéntate uno largo; es tu "contraseña" del plan Pro.
PRO_ACCESS_CODE=

# Opcional: clave para firmar la cookie del plan.
# Si no la pones, se firma con la clave de la IA que estés usando.
PRO_SECRET=

# ─── Imágenes y vídeo ────────────────────────────────────────
# Las imágenes salen con GOOGLE_API_KEY, ya incluida arriba.
# El vídeo (Veo) NO entra en la capa gratuita: necesita una
# cuenta de Google con facturación activada.

# Alternativa solo para imágenes si prefieres OpenAI.
# OPENAI_API_KEY=

# Opcional: fijar los modelos de imagen y vídeo.
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
# OPENAI_IMAGE_MODEL=gpt-image-1

# ─── GitHub (opcional) ───────────────────────────────────────
# Solo si quieres el botón "Entrar con GitHub". Sin esto puedes
# conectar igualmente con un token personal desde la aplicación.
# Crea una OAuth App en https://github.com/settings/developers
# con callback: https://TU-DOMINIO/api/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
