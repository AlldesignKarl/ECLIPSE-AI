# ─────────────────────────────────────────────────────────────
#  ECLIPSE AI · variables de entorno
#  Copia este archivo como .env.local para desarrollo, o pega
#  estas variables en el panel de tu hosting (Vercel, etc.).
# ─────────────────────────────────────────────────────────────

# ─── El motor de la IA ───────────────────────────────────────
# Hace falta UNA. Las tres primeras son gratuitas y no piden tarjeta.
# También se pueden pegar desde Ajustes, dentro de la propia aplicación.

# GRATIS, sin tarjeta, MEDIO MILLÓN de tokens por minuto: https://console.mistral.ai/api-keys
# El de más margen con diferencia, y el recomendado: es el único con el que
# ECLIPSE CODE entrega archivos largos sin cortarlos. Trae además Codestral y
# Devstral, hechos para programar. Pide verificar un teléfono, no tarjeta.
MISTRAL_API_KEY=

# GRATIS, sin tarjeta, ~1.000 mensajes al día: https://console.groq.com/keys
# El más rápido. No busca en internet ni mira imágenes.
GROQ_API_KEY=

# GRATIS, sin tarjeta, límite diario corto: https://aistudio.google.com/apikey
# El único que busca en Google con fuentes, lee imágenes y PDF y crea imágenes.
GOOGLE_API_KEY=

# GRATIS, sin tarjeta, ~50 mensajes al día: https://openrouter.ai/keys
# Muchos modelos abiertos. Buen recambio cuando los otros se agotan.
# OPENROUTER_API_KEY=

# De pago por uso: https://console.anthropic.com
# Alternativa si prefieres este motor. No tiene capa gratuita.
# ANTHROPIC_API_KEY=

# Con varias configuradas se prueban en orden. Fuérzalo con:
# mistral | groq | google | openrouter | anthropic
# AI_PROVIDER=mistral

# Opcional: un motor DISTINTO solo para ECLIPSE CODE. Sirve para dejar el
# rápido en el chat y el de más margen para los archivos largos.
# CODE_PROVIDER=mistral
# CODE_MODEL=codestral-latest

# Opcional: fijar el modelo de los motores gratuitos.
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENROUTER_MODEL=
# MISTRAL_MODEL=mistral-large-latest

# Opcional. Si no se pone, la aplicación elige un modelo disponible sola.
# GEMINI_MODEL=gemini-3.6-flash
# ANTHROPIC_MODEL=claude-opus-5

# ─── Dirección pública (opcional) ────────────────────────────
# Solo hace falta el día que tengas dominio propio: es la dirección
# que se pone en los enlaces para Google y para las redes sociales.
# Sin esto se usa la que Vercel asigne al proyecto.
# NEXT_PUBLIC_SITE_URL=https://tudominio.com

# ─── Cuentas: correo y contraseña (opcional) ─────────────────
# Sin esto la app funciona igual, pero sin registro: cada uno usa
# ECLIPSE en su dispositivo y nada le sigue a otro móvil.
#
# Hace falta un Redis con API REST. Gratis y sin tarjeta:
#   - Desde Vercel: pestaña Storage → Marketplace → Upstash Redis.
#     Vercel pone solas KV_REST_API_URL y KV_REST_API_TOKEN, pero solo si
#     conectas la base al proyecto que sirve la web. Si tienes varias cuentas,
#     comprueba que es la que tiene el dominio, no otra con el mismo nombre.
#   - O a mano, que nunca falla: crea la base en https://console.upstash.com,
#     abre su apartado Connect (pestaña REST), y copia estas dos líneas a las
#     variables de entorno del proyecto. Son las dos de abajo, tal cual.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Opcional: clave para firmar la cookie de sesión. Si no se pone,
# se firma con la del propio Redis. Cambiarla cierra las sesiones.
# AUTH_SECRET=

# ─── Plan Pro ────────────────────────────────────────────────
# Cuentas con el Pro regalado, separadas por comas. Se comparan por
# huella, así que aquí sí van en claro pero nunca salen de tu servidor.
# PRO_EMAILS=alguien@ejemplo.com,otro@ejemplo.com

# Código que desbloquea el modo Bot y el modo Profundo.
# Invéntate uno largo; es tu "contraseña" del plan Pro.
PRO_ACCESS_CODE=

# Opcional: clave para firmar la cookie del plan.
# Si no la pones, se firma con la clave de la IA que estés usando.
PRO_SECRET=

# ─── Cobro de la suscripción (opcional) ──────────────────────
# Stripe se encarga del dinero: tarjetas, facturas y cancelaciones.
# Crear la cuenta es gratis; Stripe se queda una comisión por cobro.
# La clave está en el panel de Stripe → Developers → API keys.
STRIPE_SECRET_KEY=

# Precio en céntimos. 1000 = 10,00 € al mes.
# PRO_PRICE_CENTS=1000
# PRO_CURRENCY=eur

# Opcional: si prefieres crear el precio en el panel de Stripe,
# pega aquí su id y se usará ese en lugar del de arriba.
# STRIPE_PRICE_ID=

# ─── Imágenes ────────────────────────────────────────────────
# Las imágenes salen con GOOGLE_API_KEY, ya incluida arriba.

# Si no hay ninguna clave con cuota, las imágenes salen igual: se usa un
# servicio gratuito que no pide clave (más lento y más justo de calidad).

# Mejor que ese servicio de reserva y también gratis: Cloudflare Workers AI.
# 10.000 "neuronas" al día sin tarjeta, que dan para cientos de imágenes.
# El ID de cuenta y el token están en https://dash.cloudflare.com (AI → Workers AI).
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell

# Alternativa solo para imágenes si prefieres OpenAI.
# OPENAI_API_KEY=

# Opcional: fijar el modelo de imagen.
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# OPENAI_IMAGE_MODEL=gpt-image-1

# ─── Búsqueda web propia (opcional) ──────────────────────────
# Google y Anthropic buscan por su cuenta. Los demás motores NO, así que sin
# una de estas claves ECLIPSE no puede consultar internet con ellos.
# Se usa la primera que esté puesta.
# TAVILY_API_KEY=      # 1.000 búsquedas al mes gratis: https://tavily.com
# BRAVE_API_KEY=       # https://brave.com/search/api
# SERPER_API_KEY=      # https://serper.dev

# ─── Mapas y ubicación (opcional) ────────────────────────────
# Sin clave, la ubicación FUNCIONA IGUAL: se usa OpenStreetMap, que es gratis y
# no pide alta. Lo que cambia con la clave de Google es que las distancias son
# las de la carretera y no en línea recta, y que los sitios traen horario y
# valoraciones. Hace falta activar Geocoding, Places y Directions.
# GOOGLE_MAPS_API_KEY=

# ─── Biblioteca de imágenes (opcional) ───────────────────────
# Sin nada de esto la Biblioteca funciona: busca en Wikimedia Commons y en el
# Art Institute of Chicago, que no piden cuenta. Openverse dejó de responder a
# quien no se identifica; si quieres usarlo también, date de alta y pon las dos.
# OPENVERSE_CLIENT_ID=
# OPENVERSE_CLIENT_SECRET=

# ─── El reloj de los encargos programados (opcional) ─────────
# Vercel llama solo a /api/tareas/ejecutar una vez al día (está en vercel.json)
# y se le reconoce por su propia cabecera, así que esto NO hace falta. Ponlo
# solo si quieres poder dispararlo a mano desde fuera.
# CRON_SECRET=
