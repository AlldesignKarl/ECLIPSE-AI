# ─────────────────────────────────────────────────────────────
#  ECLIPSE AI · variables de entorno
#  Copia este archivo como .env.local para desarrollo, o pega
#  estas variables en el panel de tu hosting (Vercel, etc.).
# ─────────────────────────────────────────────────────────────

# OBLIGATORIA. Sin esto la IA no responde.
# Se saca en https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# Opcional. Modelo a usar. Por defecto: claude-opus-5
# ANTHROPIC_MODEL=claude-opus-5

# ─── Plan Pro ────────────────────────────────────────────────
# Código que desbloquea vídeo, modo código y GitHub.
# Invéntate uno largo; es tu "contraseña" del plan Pro.
PRO_ACCESS_CODE=

# Opcional pero recomendable: clave para firmar la cookie del plan.
# Si no la pones, se firma con ANTHROPIC_API_KEY.
PRO_SECRET=

# ─── Imágenes y vídeo ────────────────────────────────────────
# Google AI Studio (https://aistudio.google.com/apikey)
# Da acceso a generación de imágenes y a vídeo con Veo.
GOOGLE_API_KEY=

# Alternativa solo para imágenes si prefieres OpenAI.
# OPENAI_API_KEY=

# Opcional: fijar los modelos concretos.
# GEMINI_IMAGE_MODEL=gemini-3-pro-image-preview
# GEMINI_VIDEO_MODEL=veo-3.1-generate-preview
# OPENAI_IMAGE_MODEL=gpt-image-1

# ─── GitHub (opcional) ───────────────────────────────────────
# Solo si quieres el botón "Entrar con GitHub".
# Sin esto igualmente puedes conectar con un token personal
# desde la propia aplicación.
# Crea una OAuth App en https://github.com/settings/developers
# con callback: https://TU-DOMINIO/api/github/oauth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
